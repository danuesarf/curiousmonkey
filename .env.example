# Copy to .env. Never commit the real file.
NODE_ENV=production
PORT=8080
PUBLIC_URL=http://localhost:8080
# Postgres password. Used by the postgres container and the app. Any characters are fine.
POSTGRES_PASSWORD=
# Host port for the portal. Change it if 8080 is taken.
HOST_PORT=8080
# Only for running outside docker compose:
# DATABASE_URL=postgres://cm:cm@localhost:5432/cm
DATABASE_SSL=false
# With DATABASE_SSL=true the server certificate is verified. For RDS, point this at the RDS CA bundle (PEM):
# DATABASE_SSL_CA=/etc/ssl/rds-global-bundle.pem
# Encrypt without verifying (not recommended; logged as a warning on every start):
# DATABASE_SSL_INSECURE=true

# Optional read replica. Events and Space do their heavy reads here instead of on the primary, so they never
# compete with the worker's writes. A streaming replica a few seconds behind is fine. Leave unset to use the primary.
# DATABASE_READ_URL=postgres://cm:change-me@postgres-replica:5432/cm
# Space and the first page of Events are remembered in the API process for this long (ms) and refreshed in the
# background while someone is looking. 0 turns it off.
# CACHE_FRESH_MS=20000

# Required in production, at least 32 characters each. Generate with: openssl rand -base64 48
SESSION_SECRET=
DATA_ENCRYPTION_KEY=

# 'aws' for real accounts, 'demo' for a fake estate you can click through.
AWS_MODE=aws
# The IAM role/user the worker runs as. It goes into each account's scanner trust policy.
SCANNER_PRINCIPAL_ARN=
SCANNER_ROLE_NAME=CuriousMonkeyScanner
DEFAULT_REGIONS=us-east-1,ap-southeast-1,ap-southeast-3

# Daily scan time (worker). Missed days are caught up.
SCAN_AT=01:00
# Between daily scans, read new CloudTrail events every N minutes (0 = off). Also editable in Configuration.
TAIL_EVERY_MINUTES=30
SCAN_TZ=Asia/Jakarta

# AI-assisted policy drafting through Amazon Bedrock. Off: rules-based drafts only.
BEDROCK_ENABLED=false
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0

# Optional
ALLOWED_EMAIL_DOMAINS=
APPROVAL_WEBHOOK_URL=
# Time zone the portal shows times in (each person can switch to their browser's); defaults to SCAN_TZ
DISPLAY_TZ=
# IAM user credential thresholds, in days (also settable on Admin → Configuration)
KEY_ROTATE_DAYS=90
KEY_UNUSED_DAYS=90
# Alerts (Admin → Alerts): when daily digests go out (local time, SCAN_TZ), and the HTTP timeout per message
ALERT_DIGEST_AT=09:00
ALERT_TIMEOUT_SECONDS=10
# Sent and failed alert messages are removed after this many days (7 to 3650)
ALERT_KEEP_DAYS=90
TRUST_PROXY=false
COOKIE_SECURE=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_GROUPS_CLAIM=groups
# Google Cloud is connected on the Accounts page. With workload identity federation the worker signs in to Google
# with its own AWS credentials (the pod, task or instance role); AWS_REGION is the region it signs the request for.
# Single sign-on can also be set by an owner on the Configuration page, which overrides these.
# JumpCloud: OIDC_ISSUER=https://oauth.id.jumpcloud.com/ (trailing slash) and OIDC_SCOPES="openid email profile".

# Reading S3 trails (worker). Defaults suit most estates; Configuration and the Workers page show the effect.
# TRAIL_DOWNLOADS=16        log files downloaded in parallel
# TRAIL_AHEAD_FILES=96      how many files may be downloaded ahead of the writer
# TRAIL_AHEAD_MB=192        ... and how many MB
# TRAIL_BATCH_EVENTS=50000  events written per transaction
# TRAIL_PARSERS=            parser threads; default one per core beyond two (none on 1-3 cores)
# TRAIL_PARSER_HEAP_MB=384  heap limit of each parser thread
