{
  "name": "curious-monkey",
  "version": "0.1.0",
  "description": "Curious Monkey: find what each IAM role really uses, and take away the bazooka.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "migrate": "node src/migrate.js",
    "scan": "node src/cli.js scan",
    "demo": "node src/cli.js demo",
    "catalog": "node scripts/build-catalog.mjs",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 --test-force-exit test/*.test.js",
    "security": "bash scripts/security-scan.sh",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-accessanalyzer": "3.1163.0",
    "@aws-sdk/client-bedrock-runtime": "3.1163.0",
    "@aws-sdk/client-cloudtrail": "3.1163.0",
    "@aws-sdk/client-iam": "3.1163.0",
    "@aws-sdk/client-organizations": "3.1163.0",
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/client-sts": "3.1163.0",
    "@aws-sdk/credential-provider-node": "3.972.94",
    "express": "5.3.0",
    "google-auth-library": "11.3.4",
    "helmet": "8.3.0",
    "openid-client": "5.7.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloud-copilot/iam-data": "0.22.202611061",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "embedded-postgres": "18.0.0-beta.15",
    "eslint": "10.14.0",
    "globals": "17.14.0"
  },
  "license": "MIT",
  "overrides": {
    "minimatch": "11.0.5"
  }
}
